<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#FF5A0A</color>
    <color name="ink">#1C1C1E</color>
    <color name="muted">#6B7280</color>
    <style name="Theme.HoopLock" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <style name="Theme.HoopLock.Lock">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
